#!/usr/bin/env bash
# Classify active delivery for cron: idle | status | work (no secrets, no Slack).
set -euo pipefail
export HOME=/home/chucky
WS="${OC_WORKSPACE:-/home/chucky/.openclaw/workspace}"
ACTIVE="$WS/memory/delivery-active.md"

emit() {
  # kind=idle|status|work
  local kind="$1"
  shift
  printf 'kind=%s\n' "$kind"
  if [[ "$#" -gt 0 ]]; then
    printf '%s\n' "$@"
  fi
}

if [[ ! -f "$ACTIVE" ]]; then
  emit idle "reason=missing_active"
  exit 0
fi

rel="$(sed -n 's/^- \*\*File:\*\*[[:space:]]*//p' "$ACTIVE" | head -1 | tr -d '\r' | sed 's/[[:space:]]*$//')"
status="$(sed -n 's/^- \*\*Status:\*\*[[:space:]]*//p' "$ACTIVE" | head -1 | tr -d '\r' | sed 's/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')"

if [[ -z "${rel:-}" || "$rel" == "none" || -z "${status:-}" || "$status" == "none" || "$status" == "paused" || "$status" == "done" ]]; then
  emit idle "reason=inactive" "status=${status:-}" "file=${rel:-none}"
  exit 0
fi

if [[ "$rel" = /* ]]; then
  DELIVERY="$rel"
else
  DELIVERY="$WS/$rel"
fi

if [[ ! -f "$DELIVERY" ]]; then
  emit idle "reason=missing_delivery" "file=$rel"
  exit 0
fi

auto="$(sed -n 's/^- \*\*auto_continue:\*\*[[:space:]]*//p' "$DELIVERY" | head -1 | tr -d '\r' | sed 's/[[:space:]]*$//' | tr '[:upper:]' '[:lower:]')"
title="$(sed -n 's/^# Delivery:[[:space:]]*//p' "$DELIVERY" | head -1 | tr -d '\r')"
pending="$(grep -cE '^\- \[ \] ' "$DELIVERY" || true)"
done_n="$(grep -cE '^\- \[x\] ' "$DELIVERY" || true)"
next="$(grep -nE '^\- \[ \] ' "$DELIVERY" | head -1 || true)"

if [[ "${pending:-0}" -eq 0 ]]; then
  emit status \
    "action=complete" \
    "title=${title:-delivery}" \
    "status=$status" \
    "file=$rel" \
    "pending=0" \
    "done=${done_n:-0}"
  exit 0
fi

if [[ "$auto" == "true" || "$auto" == "yes" || "$auto" == "1" ]]; then
  emit work \
    "action=auto_continue" \
    "title=${title:-delivery}" \
    "status=$status" \
    "file=$rel" \
    "auto_continue=true" \
    "pending=$pending" \
    "done=${done_n:-0}" \
    "next=${next:-(none)}"
  exit 0
fi

emit status \
  "action=waiting" \
  "title=${title:-delivery}" \
  "status=$status" \
  "file=$rel" \
  "auto_continue=${auto:-false}" \
  "pending=$pending" \
  "done=${done_n:-0}" \
  "next=${next:-(none)}"
exit 0
